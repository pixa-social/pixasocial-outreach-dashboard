{
  "functions": {
    "api/outreach.js": {
      "includeFiles": "api/d0.txt,api/d1.txt,api/d2.txt,api/d3.txt"
    }
  },
  "rewrites": [
    {
      "source": "/data/outreach.json",
      "destination": "/api/outreach"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60" }]
    }
  ]
}
